---
import ExperienceTimelineItem from "@components/ExperienceTimelineItem.astro";
import Title from "@components/Title.astro";
import ChevronUp from "@components/icons/ChevronUp.astro";
import { SECTIONS_IDS } from "@utils/constants";
---

<section id={SECTIONS_IDS.experience} class="flex flex-col gap-12">
  <Title>Experience</Title>
  <div class="flex flex-col justify-center text-start">
    <div class="relative">
      <ol class="flex flex-col gap-10 border-s border-gray-200 pt-4 pb-5 dark:border-gray-700">
        <ExperienceTimelineItem
          title="Senior Software Engineer"
          company="Cocos Capital"
          companyHref="https://cocos.capital/"
          companyColorClasses="text-sky-400"
          dotColorClasses="border-sky-200 bg-sky-200 dark:border-sky-600 dark:bg-sky-500"
          timePeriod="Mar 2026 - Present"
          technologies={[
            "React Native",
            "Expo",
            "Express",
            "Typescript",
            "Node",
            "PostgreSQL",
            "Figma",
            "Jest",
          ]}
        >
          <p>
            <span class="text-slate-800 dark:text-slate-100">
              Architect and build core features
            </span>{" "}
            for the account and growth team that directly impact the user's
            experience, engagement and retention.
          </p>
        </ExperienceTimelineItem>

        <ExperienceTimelineItem
          title="Software Developer"
          company="Sirius Software"
          companyHref="https://sirius.com.ar"
          companyColorClasses="text-yellow-500"
          dotColorClasses="border-yellow-200 bg-yellow-200 dark:border-yellow-600 dark:bg-yellow-500"
          timePeriod="Nov 2020 - Mar 2026"
        >
          <p>
            Progressed from trainee to full-time Software Developer,
            demonstrating rapid growth and technical proficiency.
          </p>
          <p>
            Delivered high-quality web applications across diverse industries
            for{" "}
            <span class="text-slate-800 dark:text-slate-100">
              startups and enterprise clients
            </span>
            , adapting to unique business requirements and technical
            constraints.
          </p>
          <p>
            Mentored junior colleagues, conducted technical interviews for open
            positions, performed code reviews, and led development teams to
            ensure project success.
          </p>
        </ExperienceTimelineItem>
      </ol>
      <ChevronUp classes="absolute -left-[7.5px] -top-3" />
    </div>

    <div>
      <h4 class="w-fit border-s border-b border-gray-200 bg-linear-to-b from-yellow-400 to-yellow-600 bg-clip-text px-4 pb-2 text-xl font-bold text-transparent dark:border-gray-700">
        Projects at Sirius Software
      </h4>
      <ol class="relative ml-4 flex flex-col gap-10 border-s border-gray-200 pt-4 pb-10 pl-4 dark:border-gray-700">
        <ExperienceTimelineItem
          title="Full Stack React/RoR Developer"
          dotColorClasses="border-rose-200 bg-rose-200 dark:border-rose-600 dark:bg-rose-500"
          timePeriod="Aug 2022 - Mar 2026"
          technologies={[
            "Ruby on Rails",
            "React",
            "Ruby",
            "Javascript",
            "PostgreSQL",
            "Redis",
            "MUI",
            "Docker",
            "Sidekiq",
            "RSpec",
            "Jest",
          ]}
        >
          <p>
            Contribute to a high-traffic ecommerce platform by engineering
            full-stack features and implementing technical improvements with
            focus on{" "}
            <span class="text-slate-800 dark:text-slate-100">
              performance, scalability, and security
            </span>
            .
          </p>
          <p>
            Collaborate across teams to optimize existing functionality, reduce
            technical debt, and enhance platform reliability for
            business-critical operations.
          </p>
        </ExperienceTimelineItem>

        <ExperienceTimelineItem
          title="DevOps Engineer"
          dotColorClasses="border-cyan-200 bg-cyan-200 dark:border-cyan-600 dark:bg-cyan-500"
          timePeriod="Aug 2022 - Mar 2026"
          technologies={[
            "Terraform",
            "AWS",
            "Docker",
            "GitLab CI/CD",
            "Linux",
            "Nginx",
            "PostgreSQL",
            "Tailscale",
          ]}
        >
          <p>
            <span class="text-slate-800 dark:text-slate-100">
              Developed and maintained infrastructure
            </span>{" "}
            for a data-sensitive web application using{" "}
            <span class="text-slate-800 dark:text-slate-100">
              AWS and Terraform
            </span>
            .
          </p>
          <p>
            Implemented security measures to protect sensitive data and secured
            application access through a Tailscale VPN.
          </p>
          <p>
            Implemented{" "}
            <span class="text-slate-800 dark:text-slate-100">
              CI/CD pipelines
            </span>{" "}
            for automated deployment and testing.
          </p>
          <p>
            Monitored and{" "}
            <span class="text-slate-800 dark:text-slate-100">
              optimized infrastructure
            </span>{" "}
            performance and scalability.
          </p>
        </ExperienceTimelineItem>

        <ExperienceTimelineItem
          title="Full Stack MERN Developer"
          dotColorClasses="border-yellow-200 bg-yellow-200 dark:border-yellow-600 dark:bg-yellow-500"
          timePeriod="Sep 2022 - Apr 2023"
          technologies={[
            "React",
            "NodeJS",
            "Express",
            "MongoDB",
            "Javascript",
            "Redux",
            "HTML",
            "CSS",
            "Sass",
          ]}
        >
          <p>
            <span class="text-slate-800 dark:text-slate-100">
              Architected and built impactful features for a people matchmaking
              platform
            </span>
            , focusing primarily on frontend user experience and interactive
            components.
          </p>
          <p>
            Contributed to the full product lifecycle including API development,
            configuration management, and deployment processes.
          </p>
        </ExperienceTimelineItem>

        <ExperienceTimelineItem
          title="React Developer"
          dotColorClasses="border-teal-200 bg-teal-200 dark:border-teal-600 dark:bg-teal-500"
          timePeriod="Jan 2021 - Sep 2022"
          technologies={[
            "React",
            "Javascript",
            "Redux",
            "MUI",
            "HTML",
            "CSS",
            "Sass",
          ]}
        >
          <p>
            Engineered performance-optimized dashboards and interactive
            interfaces for a SaaS platform serving sales engineers.
          </p>
          <p>
            <span class="text-slate-800 dark:text-slate-100">
              Led development of business-critical features
            </span>{" "}
            including real-time form auto-saving functionality and the
            Salesforce integration interface.
          </p>
        </ExperienceTimelineItem>

        <ExperienceTimelineItem
          title="React Native Developer"
          dotColorClasses="border-lime-200 bg-lime-200 dark:border-lime-600 dark:bg-lime-500"
          timePeriod="Dec 2020 - Feb 2021"
          technologies={[
            "React Native",
            "Javascript",
            "Expo",
            "Firebase",
            "Strapi",
          ]}
        >
          <p>
            Developed a mobile application and integrated it with a content
            management system.
          </p>
        </ExperienceTimelineItem>

        <ExperienceTimelineItem
          title="Frontend Web Developer Trainee"
          dotColorClasses="border-blue-200 bg-blue-200 dark:border-blue-600 dark:bg-blue-500"
          timePeriod="Nov 2020 - Dec 2020"
          technologies={["React", "Javascript", "Redux", "HTML", "CSS", "Sass"]}
        >
          <p>
            Joined Sirius Software and took my first steps in the software
            development industry as a frontend trainee.
          </p>
        </ExperienceTimelineItem>
      </ol>
    </div>

    <div class="relative">
      <ol class="flex w-fit flex-col gap-10 border-s border-t border-gray-200 pt-4 pr-4 pb-4 dark:border-gray-700">
        <ExperienceTimelineItem
          title="Systems Lab Intern"
          dotColorClasses="border-green-800 bg-green-800 dark:border-green-800 dark:bg-green-600"
          timePeriod="Apr 2019 - Dec 2020"
          technologies={["Python", "C/C++", "Arduino", "Linux"]}
          liClass="max-w-[750px]"
        >
          <p>
            Led{" "}
            <span class="text-slate-800 dark:text-slate-100">
              research and development
            </span>{" "}
            for an innovative therapy-focused gaming console designed for
            disabled children. Implemented haptic feedback and motion-sensing
            capabilities and designed control systems that enhanced
            accessibility and the overall therapeutic experience.
          </p>
        </ExperienceTimelineItem>
      </ol>
      <span
        class="absolute -start-[5.5px] size-3 rounded-full border border-white bg-gray-200 dark:border-gray-700 dark:bg-gray-700"
        aria-hidden="true"
      ></span>
    </div>
  </div>
</section>
